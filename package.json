{
  "name": "sachin-shakya-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "git config core.hooksPath .githooks",
    "test:firestore": "tsx scripts/test-firestore.ts",
    "test:cloudinary": "tsx scripts/test-cloudinary.ts",
    "seed": "tsx scripts/seed/seed.ts",
    "cleanup": "tsx scripts/cleanup/cleanup.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.134.0"
  }
}
