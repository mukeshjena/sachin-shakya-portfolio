#!/bin/sh
# .githooks/pre-commit
# ─────────────────────────────────────────────────────────────────────────────
# Runs automatically before every `git commit`.
# Blocks the commit if any check fails — fix the issue and re-commit.
#
# Activated by: npm run prepare  (sets git config core.hooksPath .githooks)
# To skip in emergencies ONLY:  git commit --no-verify  (use sparingly)
# ─────────────────────────────────────────────────────────────────────────────

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo ""
echo "${BOLD}Pre-commit checks — Sachin Shakya Portfolio${RESET}"
echo "─────────────────────────────────────────────"

FAILED=0

# ── 1. Biome: lint + format ───────────────────────────────────────────────────
echo "${YELLOW}[1/3]${RESET} Biome lint + format check..."
npx biome check .
if [ $? -ne 0 ]; then
  echo "${RED}✗ Biome check failed.${RESET}"
  echo "  Run ${BOLD}npm run check:fix${RESET} to auto-fix format issues, then re-stage and commit."
  FAILED=1
else
  echo "${GREEN}✓ Biome passed.${RESET}"
fi

# ── 2. TypeScript: strict type check ─────────────────────────────────────────
echo "${YELLOW}[2/3]${RESET} TypeScript strict type check..."
npx tsc -b
if [ $? -ne 0 ]; then
  echo "${RED}✗ TypeScript check failed.${RESET}"
  echo "  Fix all type errors before committing."
  FAILED=1
else
  echo "${GREEN}✓ TypeScript passed.${RESET}"
fi

# ── 3. Vite build: ensures the app actually bundles ───────────────────────────
echo "${YELLOW}[3/3]${RESET} Vite production build..."
npx vite build --silent
if [ $? -ne 0 ]; then
  echo "${RED}✗ Vite build failed.${RESET}"
  echo "  The app must build cleanly before committing."
  FAILED=1
else
  echo "${GREEN}✓ Vite build passed.${RESET}"
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo "─────────────────────────────────────────────"
if [ $FAILED -ne 0 ]; then
  echo "${RED}${BOLD}Pre-commit failed. Fix the issues above and re-commit.${RESET}"
  echo "Use ${BOLD}git commit --no-verify${RESET} ONLY in genuine emergencies."
  exit 1
fi

echo "${GREEN}${BOLD}All checks passed. Committing...${RESET}"
echo ""
exit 0
