#!/bin/sh
# .githooks/pre-push
# ─────────────────────────────────────────────────────────────────────────────
# Runs automatically before every `git push`.
# Blocks push if any check fails.
#
# RULE: `git push --no-verify` is STRICTLY PROHIBITED (Agent Rule 15).
# Bypassing hooks allows faulty code to reach remote repositories.
# Fix all issues before pushing to origin.
# ─────────────────────────────────────────────────────────────────────────────

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo ""
echo "${BOLD}Pre-push verification — Sachin Shakya Portfolio${RESET}"
echo "─────────────────────────────────────────────"

FAILED=0

# ── 1. Biome: lint + format check ─────────────────────────────────────────────
echo "${YELLOW}[1/3]${RESET} Biome check..."
npx biome check .
if [ $? -ne 0 ]; then
  echo "${RED}✗ Biome check failed.${RESET}"
  echo "  Run ${BOLD}npm run check:fix${RESET} and commit the fixes before pushing."
  FAILED=1
else
  echo "${GREEN}✓ Biome passed.${RESET}"
fi

# ── 2. TypeScript: strict type check ─────────────────────────────────────────
echo "${YELLOW}[2/3]${RESET} TypeScript strict type check..."
npx tsc -b
if [ $? -ne 0 ]; then
  echo "${RED}✗ TypeScript check failed.${RESET}"
  echo "  Fix all type errors before pushing."
  FAILED=1
else
  echo "${GREEN}✓ TypeScript passed.${RESET}"
fi

# ── 3. Vite production build check ───────────────────────────────────────────
echo "${YELLOW}[3/3]${RESET} Vite production build..."
npx vite build --logLevel silent
if [ $? -ne 0 ]; then
  echo "${RED}✗ Vite build failed.${RESET}"
  echo "  The app must build cleanly before pushing."
  FAILED=1
else
  echo "${GREEN}✓ Vite build passed.${RESET}"
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo "─────────────────────────────────────────────"
if [ $FAILED -ne 0 ]; then
  echo "${RED}${BOLD}Pre-push verification failed. Push aborted.${RESET}"
  echo "${RED}Do NOT use --no-verify to bypass. Fix the failing check and retry.${RESET}"
  exit 1
fi

echo "${GREEN}${BOLD}All pre-push checks passed. Pushing to origin...${RESET}"
echo ""
exit 0
